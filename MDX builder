from typing import List, Union, Optional
from mdxpy import MdxBuilder, MdxHierarchySet, Member, MdxTuple

class DynamicMdxEngine:
    """
    A reusable engine to dynamically generate MDX query strings 
    for any IBM Planning Analytics (TM1) cube.
    """
    def __init__(self, cube_name: str):
        self.cube_name = cube_name
        self.builder = MdxBuilder(cube=cube_name)
        
    def configure_columns(self, dimensions: Union[str, List[str]], subset_name: str = "Default") -> "DynamicMdxEngine":
        """Adds one or more dimensions to the Column Axis (Axis 0)."""
        if isinstance(dimensions, str):
            dimensions = [dimensions]
            
        for dim in dimensions:
            # Assumes default hierarchy matches dimension name
            h_set = MdxHierarchySet.tm1_subset_all(dim, subset_name)
            self.builder.add_hierarchy_set_to_column_axis(h_set)
        return self
        
    def configure_rows(self, dimensions: Union[str, List[str]], subset_name: str = "Default", suppress_zeros: bool = True) -> "DynamicMdxEngine":
        """Adds one or more dimensions to the Row Axis (Axis 1)."""
        if isinstance(dimensions, str):
            dimensions = [dimensions]
            
        for dim in dimensions:
            h_set = MdxHierarchySet.tm1_subset_all(dim, subset_name)
            axis = self.builder.add_hierarchy_set_to_row_axis(h_set)
            if suppress_zeros:
                axis.suppress_zeroes()
        return self
        
    def configure_context_filter(self, tuple_slices: List[tuple]) -> "DynamicMdxEngine":
        """
        Restricts the cube data using WHERE slicers.
        Pass a list of tuples containing (Dimension, Element).
        Example: [("Year", "2026"), ("Version", "Actual")]
        """
        if not tuple_slices:
            return self
            
        members = [Member.of(dim, elem) for dim, elem in tuple_slices]
        where_clause = MdxTuple.of(*members)
        self.builder.add_where_sliced_by_tuple(where_clause)
        return self
        
    def generate(self) -> str:
        """Compiles and returns the finalized raw MDX query string."""
        return self.builder.to_mdx()

# ==========================================
# EXAMPLES OF MULTI-CUBE REUSE SCENARIOS
# ==========================================
if __name__ == "__main__":
    print("--- Scenario 1: Generating Query for 'Sales' Cube ---")
    sales_query = (
        DynamicMdxEngine(cube_name="Sales")
        .configure_columns(dimensions="Month", subset_name="All Members")
        .configure_rows(dimensions=["Region", "Product"], suppress_zeros=True)
        .configure_context_filter([("Year", "2026"), ("Version", "Budget")])
        .generate()
    )
    print(sales_query)
    print("\n" + "="*50 + "\n")
    
    print("--- Scenario 2: Generating Query for 'Finance' Cube ---")
    finance_query = (
        DynamicMdxEngine(cube_name="Finance")
        .configure_columns(dimensions=["Account", "Measures"])
        .configure_rows(dimensions="Department", suppress_zeros=False)
        .configure_context_filter([("Year", "2025"), ("Scenario", "Forecast")])
        .generate()
    )
    print(finance_query)
