import pandas as pd
from TM1py.Services import TM1Service
from ultimate_mdx_engine import UltimateMdxEngine

# 1. Initialize and build our ultimate query string
engine = UltimateMdxEngine(cube_name="Finance")
engine.add_calculated_member(
    dimension="Measures", 
    member_name="Variance_Pct", 
    formula_mdx="([Measures].[Amount]) / ([Measures].[Budget_Amount])"
)

columns = [{"dimension": "Measures", "specific_members": ["Amount", "Variance_Pct"]}]
rows = [
    {
        "dimension": "Account",
        "level": 0,
        "output_attributes": ["Description", "Account_Type"] # Extra metadata requested
    },
    {"dimension": "Region", "subset": "All Countries"}
]

mdx_statement = (
    engine.configure_columns(columns)
    .configure_rows(rows, suppress_zeros=True)
    .configure_context_filter([("Year", "Default", "2026"), ("Version", "Default", "Actual")])
    .generate()
)

# 2. Connect to TM1 and retrieve the structured Pandas layout
with TM1Service(address="localhost", port=8001, user="admin", password="password", ssl=True) as tm1:
    df = tm1.cubes.cells.execute_mdx_dataframe(mdx_statement)

print("--- Step 1: Raw TM1py Structural Retrieval ---")
print(df.head())
print("Row Index Names:", df.index.names) 
# Outputs: ['Account', 'Account / Description', 'Account / Account_Type', 'Region']

# Create a copy to preserve the original structure
df_flat = df.copy()

# Step A1: Flatten Column MultiIndex from tuple layout to standard text labels
# Transforms ('Measures', 'Amount') into 'Measures_Amount'
df_flat.columns = ['_'.join(col).strip() for col in df_flat.columns.values]

# Step A2: Turn the MultiIndex Rows and Attributes into regular DataFrame columns
df_flat = df_flat.reset_index()

# Step A3: Clean up structural names (Remove TM1 syntax slashes if preferred)
df_flat.columns = [col.replace(' / ', '_') for col in df_flat.columns]

print("\n--- Method A: Flattened Database Table ---")
print(df_flat.head())
# Result: Columns become: Account | Account_Description | Account_Account_Type | Region | Measures_# Isolate your row positions using IndexSlice
idx = pd.IndexSlice

# Requirement: Filter rows where the retrieved 'Account_Type' attribute equals 'Expense'
# Syntax: df.loc[idx[Account, Description, Account_Type, Region], :]
df_expenses = df.loc[idx[:, :, 'Expense', :], :]

print("\n--- Method B: Filtered by Attribute Value ('Expense') ---")
print(df_expenses)

# Flatten just the columns for easier math referencing
df_geo = df.copy()
df_geo.columns = ['_'.join(col).strip() for col in df_geo.columns.values]

# Aggregate total amount by Region, dynamically skipping Account details
regional_sums = df_geo.groupby('Region')['Measures_Amount'].sum()

print("\n--- Method C: Aggregated Totals by Region ---")
print(regional_sums)



