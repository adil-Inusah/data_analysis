This blueprint updates the DynamicMdxEngine to handle advanced TM1 query operations: utilizing specific named subsets, filtering elements dynamically by hierarchy level or attribute value, and targeting specific unique members.
## 🛠 The Advanced Dynamic MDX Engine Code
Save this updated script to support complex expressions like FILTER, MEMBERS, and TM1-specific attribute filters.

from mdxpy import MdxBuilder, MdxHierarchySet, Member, MdxTuplefrom typing import Union, List, Tuple, Dict, Any
class AdvancedMdxEngine:
    """
    An advanced reusable factory engine wrapping MDXpy to handle subsets, 
    level/attribute filtering, unique members, and multi-axis stitching.
    """
    def __init__(self, cube_name: str):
        self.cube_name = cube_name
        self.builder = MdxBuilder(cube=cube_name)
        
    def _build_advanced_set(self, config: Dict[str, Any]) -> MdxHierarchySet:
        """
        Parses advanced dimension parameters to construct a tailored MDX hierarchy set.
        Expected config keys:
          - dimension (str)
          - subset (str, optional)
          - level (int, optional)
          - attribute_filter (dict, optional) -> {"attr_name": "attr_value"}
          - specific_members (list, optional) -> ["Elem1", "Elem2"]
        """
        dim = config["dimension"]
        hierarchy = config.get("hierarchy", "Default")
        
        # Scenario 1: Specific Explicit Members
        if "specific_members" in config and config["specific_members"]:
            member_objs = [Member.of(dim, hierarchy, m) for m in config["specific_members"]]
            # MDXpy allows initializing sets directly from Member objects
            axis_set = MdxHierarchySet.from_members(member_objs)
            
        # Scenario 2: Explicit TM1 Subset
        elif "subset" in config and config["subset"]:
            axis_set = MdxHierarchySet.tm1_subset(dim, hierarchy, config["subset"])
            
        # Scenario 3: Filter by Level (e.g., Level 0 leaves)
        elif "level" in config and config["level"] is not None:
            # Resolves to [Dimension].[Hierarchy].Members filtered by level
            base_set = MdxHierarchySet.members(dim, hierarchy)
            axis_set = base_set.filter_by_level(config["level"])
            
        # Default: Grab all members
        else:
            axis_set = MdxHierarchySet.tm1_subset_all(dim, hierarchy)
            
        # Layering Feature: Dynamic Attribute Filtering (Matches TM1 Filter by Attribute)
        if "attribute_filter" in config and config["attribute_filter"]:
            attr_name, attr_val = list(config["attribute_filter"].items())[0]
            # Uses MDXpy internal filter block to evaluate text attributes
            axis_set = axis_set.filter_by_attribute(attr_name, attr_val)
            
        return axis_set

    def configure_columns(self, dimension_configs: List[Dict[str, Any]]):
        """Processes and cross-joins advanced column configurations."""
        if not dimension_configs:
            return self
        
        axis_set = self._build_advanced_set(dimension_configs[0])
        for config in dimension_configs[1:]:
            next_set = self._build_advanced_set(config)
            axis_set = axis_set.cross_join(next_set)
            
        self.builder.add_hierarchy_set_to_column_axis(axis_set)
        return self

    def configure_rows(self, dimension_configs: List[Dict[str, Any]], suppress_zeros: bool = True):
        """Processes and cross-joins advanced row configurations with zero suppression."""
        if not dimension_configs:
            return self
            
        axis_set = self._build_advanced_set(dimension_configs[0])
        for config in dimension_configs[1:]:
            next_set = self._build_advanced_set(config)
            axis_set = axis_set.cross_join(next_set)
            
        row_axis = self.builder.add_hierarchy_set_to_row_axis(axis_set)
        if suppress_zeros:
            row_axis.suppress_zeroes()
            
        return self

    def configure_context_filter(self, slices: List[Tuple[str, str, str]]):
        """Creates a slice context tuple. Tuples accept: (Dimension, Hierarchy, Element)"""
        if slices:
            member_objects = [Member.of(dim, hi, elem) for dim, hi, elem in slices]
            context_tuple = MdxTuple.of(*member_objects)
            self.builder.add_tuple_to_where_clause(context_tuple)
        return self

    def generate(self) -> str:
        """Compiles MDX."""
        return self.builder.to_mdx()

